{
  "label" : "hyprshutdown",
  "action" : "/usr/bin/hyprlock",
  "text" : "Lock Screen",
  "keybind" : "l"  
}
{
  "label": "logout",
  "action": "$HOME/.config/wlogout/logout.sh",
  "text": "Logout",
  "keybind": "e"
}
{
  "label": "shutdown",
  "action": "$HOME/.config/wlogout/poweroff.sh",
  "text": "Shutdown",
  "keybind": "s"
}
{
  "label": "reboot",
  "action": "",
  "text": "Reboot",
  "keybind": "r"
}
