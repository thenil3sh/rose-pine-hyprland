{
  "label": "shutdown",
  "action": "/usr/bin/vspipehyprshutdown -p %h/.config/wlogout/poweroff.sh",
  "text": "Shutdown",
  "keybind": "s"
}
{
  "label": "hibernate",
  "action": "systemctl hibernate",
  "text": "Hibernate",
  "keybind": "h"
}
{
  "label": "logout",
  "action": "/usr/bin/hyprshutdown -p %h/.config/wlogout/logout.sh",
  "text": "Logout",
  "keybind": "e"
}
{
  "label": "reboot",
  "action": "/usr/bin/hyprshutdown -p %h/.config/wlogout/reboot.sh",
  "text": "Reboot",
  "keybind": "r"
}